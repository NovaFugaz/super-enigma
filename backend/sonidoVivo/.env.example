# Valores de demostración, no de producción..
MYSQL_DATABASE=sonidovivo
MYSQL_USER=sonidovivo
MYSQL_PASSWORD=sonidovivo-local
MYSQL_ROOT_PASSWORD=root-local-only
MYSQL_PORT=3307

# Valor para la demo.
JWT_SECRET=SonidoVivoSoloLaboratorioClaveSecretaDeEjemploMuyLarga12345

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

BACKEND_MEMORY_LIMIT=768m
MYSQL_MEMORY_LIMIT=768m
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0 -XX:InitialRAMPercentage=20.0 -XX:+UseSerialGC
